    },
    {
      "rule": {
        "id": "lrn32_physical_occlusion_strategy",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 8,
        "text": "For complex underwater human anatomy, physically justified bubbles/turbulence may obscure non-critical anatomical detail when the brief does not require that detail, provided the required pose silhouette, human proportions, orientation, and continuity remain readable."
      },
      "metadata": {
        "rule_id": "lrn32_physical_occlusion_strategy",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "RECOMMEND",
        "priority": 780,
        "when": {
          "all": [
            {
              "path": "media",
              "op": "eq",
              "value": "image"
            },
            {
              "path": "physics.water",
              "op": "eq",
              "value": true
            },
            {
              "path": "subject.human",
              "op": "eq",
              "value": true
            },
            {
              "path": "risk_flags",
              "op": "contains",
              "value": "HUMAN_ANATOMY"
            }
          ]
        },
        "validator": {
          "id": "v32:physical-occlusion",
          "kind": "semantic"
        },
        "supersedes": [],
        "conflict_key": null,
