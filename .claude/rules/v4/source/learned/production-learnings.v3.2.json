          "reviewer": "APD-v3.2-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "Repeated verbose rewrites degraded adherence while local edits preserved strengths."
        }
      }
    },
    {
      "rule": {
        "id": "lrn32_domain_pose_literal",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 3,
        "text": "Preserve a sufficiently specific domain-native pose/technique label instead of expanding it into speculative anatomy. Expand only when the target adapter requires it or evidence shows the literal domain label fails."
      },
