        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 7,
        "text": "Do not amplify an unspecified quantity, density, intensity, or prominence. Presence of an element does not authorize sparse/full/dense/large unless the brief or inherited state specifies it."
      },
