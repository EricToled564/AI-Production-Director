{
  "version": "3.2.1",
  "status": "PUBLISHED_LEARNED_OVERLAY",
  "provenance": {
    "source": "controlled production trial: Olympic 10 m platform diver, split-level underwater editorial image",
    "date": "2026-09-11",
    "policy": "Empirical production learnings do not mutate the canonical KB extractor. They are versioned overlays and require regression tests before promotion. v3.2.1 adds composition-abstraction/no-reference and cross-task lock isolation."
  },
  "rules": [
    {
      "rule": {
        "id": "lrn32_lock_preservation",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 1,
        "text": "On a revision, every user/project lock remains inherited verbatim unless the user explicitly changes that lock."
      },
      "metadata": {
        "rule_id": "lrn32_lock_preservation",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "REQUIRE",
        "priority": 920,
        "when": {
          "path": "stage",
          "op": "in",
          "value": [
            "prompt",
            "generation",
            "qa"
          ]
        },
        "validator": {
          "id": "v32:lock-preservation",
          "kind": "semantic"
        },
        "supersedes": [],
        "conflict_key": null,
        "classification_provenance": {
          "method": "production_trial",
          "reviewer": "APD-v3.2-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "Prevents revision drift observed when correcting the diver pose."
        }
      }
    },
    {
