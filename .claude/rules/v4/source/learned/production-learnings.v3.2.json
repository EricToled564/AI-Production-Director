        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 10,
        "text": "Do not declare a generated asset or model successful for a case before running the applicable QA. Separate deterministic/mechanical checks from semantic visual checks and mark non-visually-verifiable brief facts as such rather than PASS."
      },
