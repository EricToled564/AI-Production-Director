        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 2,
        "text": "When correcting a localized failure in an otherwise accepted or strong asset, change only the failed element(s); do not rewrite or reinterpret unaffected locks."
      },
