    {
      "rule": {
        "id": "lrn32_nano_underwater_diving_route",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 12,
        "text": "For complex split-level underwater images with a human in Olympic/platform diving or similarly extreme aquatic anatomy, prefer Nano Banana Pro as the default model candidate unless the user explicitly locks another model or current benchmark evidence supersedes this heuristic."
      },
      "metadata": {
        "rule_id": "lrn32_nano_underwater_diving_route",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "RECOMMEND",
        "priority": 850,
        "when": {
          "all": [
            {
              "path": "media",
              "op": "eq",
              "value": "image"
            },
            {
              "path": "task.tags",
              "op": "contains",
              "value": "AQUATIC"
            },
            {
              "path": "task.tags",
              "op": "contains",
              "value": "OLYMPIC_DIVING"
            },
            {
              "path": "subject.human",
              "op": "eq",
              "value": true
            },
            {
              "path": "composition.split_level",
              "op": "eq",
              "value": true
            },
            {
              "path": "risk_flags",
              "op": "contains",
              "value": "HUMAN_ANATOMY"
            }
          ]
        },
        "validator": {
          "id": "v32:model-routing-evidence",
          "kind": "routing"
        },
        "supersedes": [],
        "conflict_key": null,
        "classification_provenance": {
          "method": "production_trial",
          "reviewer": "APD-v3.2-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "In this controlled trial Nano Banana Pro achieved acceptable Olympic entry anatomy and water physics where GPT Image 2 repeatedly distorted the pose/head/feet. Empirical preference, not universal capability claim."
        }
      }
    },
    {
      "rule": {
        "id": "lrn321_composition_abstraction_no_ref",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 13,
        "text": "When a user supplies an image only to follow or study its composition, first translate the visible composition into an abstract composition specification, then compile the generation prompt from that specification without attaching or treating the source image as a generation reference unless the user explicitly requests reference-image use."
      },
      "metadata": {
        "rule_id": "lrn321_composition_abstraction_no_ref",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "REQUIRE",
        "priority": 955,
        "when": {
          "all": [
            {
              "path": "media",
              "op": "eq",
              "value": "image"
            },
            {
              "path": "stage",
              "op": "in",
              "value": [
                "brief",
                "prompt",
                "generation"
              ]
            }
          ]
        },
        "validator": {
          "id": "v321:composition-abstraction",
          "kind": "process"
        },
        "supersedes": [],
        "conflict_key": null,
        "classification_provenance": {
          "method": "production_trial",
          "reviewer": "APD-v3.2.1-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "Tennis composition trial showed that passing a composition-only source image directly to generation copied unwanted AI-specific details instead of only the intended spatial arrangement."
        }
      }
    },
    {
