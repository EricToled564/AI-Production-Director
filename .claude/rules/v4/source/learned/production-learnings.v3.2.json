        "rule_id": "lrn32_domain_pose_literal",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "REQUIRE",
        "priority": 930,
        "when": {
          "all": [
            {
              "path": "media",
              "op": "eq",
              "value": "image"
            },
            {
              "path": "subject.human",
              "op": "eq",
              "value": true
            }
          ]
        },
        "validator": {
          "id": "v32:domain-pose-preservation",
          "kind": "semantic"
        },
        "supersedes": [],
        "conflict_key": null,
        "classification_provenance": {
          "method": "production_trial",
          "reviewer": "APD-v3.2-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "The user-specified Olympic 10 m platform entry label was clearer than assistant-added anatomical decompositions."
        }
      }
    },
    {
      "rule": {
        "id": "lrn32_reference_role_isolation",
        "skill": "learned-production",
        "source_path": "learned/production-learnings.v3.2.json",
        "line": 4,
        "text": "A reference may control only its declared role. Features explicitly excluded from that role must not be copied into subject identity, pose, camera, framing, environment, color, or other locked dimensions."
      },
      "metadata": {
        "rule_id": "lrn32_reference_role_isolation",
        "classification_status": "CLASSIFIED",
        "authority": "LEARNED_PRODUCTION",
        "effect": "REQUIRE",
        "priority": 940,
        "when": {
          "path": "references.mode",
          "op": "not_in",
          "value": [
            "none"
          ]
        },
        "validator": {
          "id": "v32:reference-role-isolation",
          "kind": "semantic"
        },
        "supersedes": [],
        "conflict_key": null,
        "classification_provenance": {
          "method": "production_trial",
          "reviewer": "APD-v3.2-learning-patch",
          "reviewed_at": "2026-09-11",
          "notes": "Water reference was useful only when explicitly isolated to bubble/turbulence physics."
        }
      }
    },
    {
