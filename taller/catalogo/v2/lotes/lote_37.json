  "pagina_final": "2",
  "tipo_unidad": "ítem de lista",
  "texto": "- Limit to one text element per prompt for reliability",
  "sha256_unidad": "2291334824f4a74c1dbfae5cf95290bb61d31e568aaa4755622713591167bf30",
  "texto_duplicado_en_otra_unidad": ""
 },
 {
  "id": "INV-011754",
  "archivo": "skills/visual-prompt-forge/adapters/gpt-image.md",
  "encabezado": "Adapter: GPT Image (1.5 / 2) › Text rendering",
  "linea_inicial": "82",
  "linea_final": "82",
  "pagina_inicial": "2",
  "pagina_final": "2",
  "tipo_unidad": "párrafo",
  "texto": "Default for storyboard work is still composited text, keep the override flag pattern from the Ideogram adapter.",
  "sha256_unidad": "1aa677245571b87bd990029f400a5089d41a9b6868c747d47d6866e124a6bdb6",
  "texto_duplicado_en_otra_unidad": ""
 },
 {
  "id": "INV-011755",
  "archivo": "skills/visual-prompt-forge/adapters/gpt-image.md",
  "encabezado": "Adapter: GPT Image (1.5 / 2) › Pitfalls to avoid",
  "linea_inicial": "84",
