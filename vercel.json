{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sample.js": {
      "maxDuration": 300
    },
    "api/taller.py": {
      "maxDuration": 300,
      "includeFiles": "taller/{*.py,api/*.py,recursos/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/taller",
      "destination": "/taller/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/taller/api/(.*)",
      "destination": "/api/taller?ruta=$1"
    }
  ]
}
